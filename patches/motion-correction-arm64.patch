diff --git a/MotionCorrection/src/cpp/Math/SIMD.h b/MotionCorrection/src/cpp/Math/SIMD.h
index dfc1ced..32d7e75 100644
--- a/MotionCorrection/src/cpp/Math/SIMD.h
+++ b/MotionCorrection/src/cpp/Math/SIMD.h
@@ -6,7 +6,30 @@
 #pragma once
 
 #include <stdint.h>
+#if defined(__aarch64__) || defined(_M_ARM64)
+// SSE intrinsics translated to NEON on ARM64 (header vendored by kimodo-turbo setup).
+// sse2neon defines and then undefines FORCE_INLINE, so keep the project's definition.
+#pragma push_macro("FORCE_INLINE")
+#undef FORCE_INLINE
+#include "sse2neon.h"
+#pragma pop_macro("FORCE_INLINE")
+// AVX vpermilps with a variable control is not covered by sse2neon: lane i takes a[control[i] & 3].
+static inline __m128 _mm_permutevar_ps( __m128 a, __m128i control )
+{
+    alignas( 16 ) float src[4];
+    alignas( 16 ) int32_t idx[4];
+    alignas( 16 ) float dst[4];
+    _mm_store_ps( src, a );
+    _mm_store_si128( reinterpret_cast<__m128i*>( idx ), control );
+    for ( int i = 0; i < 4; ++i )
+    {
+        dst[i] = src[idx[i] & 3];
+    }
+    return _mm_load_ps( dst );
+}
+#else
 #include <immintrin.h>
+#endif
 
 namespace SIMD
 {
